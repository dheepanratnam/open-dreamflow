{
  "manifest_version": 3,
  "name": "Open-DreamFlow Universal Creator Credit Bridge",
  "version": "1.2.0",
  "description": "Zero-markup bridge connecting Open-DreamFlow Studio to Dreamina, Google Flow, Higgsfield, Sume.com, Kling AI, OpenArt, ImagineArt, and ElevenLabs.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://dreamina.capcut.com/*",
    "https://jimeng.jianying.com/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://higgsfield.ai/*",
    "https://*.higgsfield.ai/*",
    "https://sume.com/*",
    "https://*.sume.com/*",
    "https://app.klingai.com/*",
    "https://klingai.com/*",
    "https://*.klingai.com/*",
    "https://openart.ai/*",
    "https://*.openart.ai/*",
    "https://imagine.art/*",
    "https://*.imagine.art/*",
    "https://elevenlabs.io/*",
    "https://*.elevenlabs.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open-DreamFlow Universal Credit Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "content-flow.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dreamina.capcut.com/*",
        "https://jimeng.jianying.com/*"
      ],
      "js": [
        "content-dreamina.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://higgsfield.ai/*",
        "https://*.higgsfield.ai/*",
        "https://sume.com/*",
        "https://*.sume.com/*",
        "https://app.klingai.com/*",
        "https://klingai.com/*",
        "https://*.klingai.com/*",
        "https://openart.ai/*",
        "https://*.openart.ai/*",
        "https://imagine.art/*",
        "https://*.imagine.art/*",
        "https://elevenlabs.io/*",
        "https://*.elevenlabs.io/*"
      ],
      "js": [
        "content-universal.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-studio.js"
      ],
      "run_at": "document_start"
    }
  ]
}

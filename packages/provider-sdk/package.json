{
  "name": "@open-dreamflow/provider-sdk",
  "version": "1.1.0",
  "description": "Zero-markup Multi-Platform Creator Credit & BYOK Provider SDK for Open-DreamFlow (Higgsfield, Kling AI, Dreamina, Google Flow, OpenArt, ImagineArt, ElevenLabs, OpenAI, Fal.ai, Replicate, Local ComfyUI)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./platforms": {
      "types": "./dist/platforms.d.ts",
      "import": "./dist/platforms.js"
    },
    "./gemini-omni": {
      "types": "./dist/gemini-omni.d.ts",
      "import": "./dist/gemini-omni.js"
    },
    "./seedance": {
      "types": "./dist/seedance.d.ts",
      "import": "./dist/seedance.js"
    },
    "./fal-replicate": {
      "types": "./dist/fal-replicate.d.ts",
      "import": "./dist/fal-replicate.js"
    },
    "./comfyui": {
      "types": "./dist/comfyui.d.ts",
      "import": "./dist/comfyui.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "open-dreamflow",
    "higgsfield",
    "kling-ai",
    "elevenlabs",
    "openai",
    "gemini-omni",
    "seedance",
    "seedream",
    "dreamina",
    "google-flow",
    "openart",
    "imagineart",
    "fal-ai",
    "replicate",
    "comfyui",
    "mcp",
    "byok"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}

# ==============================================================================
# Open-DreamFlow — Option A Cloud Stack & Zero-Markup Local Engine Env Template
# ==============================================================================
# Copy to `.env` / `.env.local` for local runs, or set in Railway + Cloudflare Pages.

# 1. Runtime & Persistence (Railway Volume /data in production)
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
OPEN_DREAMFLOW_DATA_DIR=.dreamflow-data.nosync
DREAMFLOW_DATA_DIR=.dreamflow-data.nosync
DREAMFLOW_MEDIA_DIR=apps/web-studio/public/media

# 2. Multi-User Invite Auth & AES-256-GCM Vault
DREAMFLOW_OWNER_EMAIL=owner@dreamflow.studio
DREAMFLOW_OWNER_PASSCODE=dreamflow2026
# 32+ char random secret (auto-generated in <dataDir>/.vault-master.key if unset)
DREAMFLOW_VAULT_SECRET=
# Set to 'true' in public cloud deployments (Option A / Railway)
DREAMFLOW_REQUIRE_AUTH=false

# 3. Option A Frontend Edge -> Railway Backend URL (used by Vite / Cloudflare Pages build)
VITE_API_BASE_URL=

# 4. Cloudflare R2 Zero-Egress Object Storage (packages/mcp-client/src/cloud-r2.ts)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=open-dreamflow-media
# Optional custom CDN domain (e.g. https://cdn.yourdomain.com); falls back to /media/<key>
R2_PUBLIC_BASE_URL=

# 5. Creator Platform APIs ($0 Wrapper Markup BYOK / Server Vault)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_OMNI_MODEL=gemini-omni-1.2-flash
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET_KEY=
SUME_API_KEY=
ARK_API_KEY=
SEEDANCE_API_KEY=
SEEDANCE_ENDPOINT=https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks
FAL_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
OPENART_API_KEY=
IMAGINEART_API_KEY=

# 6. Local Zero-Cost GPU Runtime & MCP Bridge
COMFYUI_BASE_URL=http://127.0.0.1:8188
MCP_BRIDGE_HOST=127.0.0.1
MCP_BRIDGE_PORT=3001
MCP_SERVER_URL=ws://localhost:3001/mcp

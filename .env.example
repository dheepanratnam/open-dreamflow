# ==============================================================================
# Open-DreamFlow — Zero-Markup BYOK, Local GPU & MCP Environment Template
# ==============================================================================
# Copy to `.env.local` if running server-side scripts or local MCP bridges.
# In Web Studio (`apps/web-studio`), you can also enter keys directly in the
# `BYOK · MCP` modal — keys stay strictly in browser localStorage ($0 markup).
# ==============================================================================

# 1. Google AI Studio — Gemini Omni 1.2 Flash (3–15s Video, 6 Refs, Multi-Turn)
# Endpoint: POST https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_API_KEY=
GEMINI_OMNI_MODEL=gemini-omni-1.2-flash

# 2. BytePlus Ark — Dreamina Seedream 3.0 & Seedance 1.0 Pro (2–10 Multiframes)
SEEDANCE_API_KEY=
SEEDANCE_ENDPOINT=https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks

# 3. Open-Weight Cloud Pass-Through ($0 Wrapper Markup — Wan 2.1, LTX, Hunyuan)
FAL_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# 4. Local Zero-Cost GPU Runtime (ComfyUI HTTP + WebSocket API)
COMFYUI_BASE_URL=http://127.0.0.1:8188

# 5. Universal Model Context Protocol (MCP) Local STDIO/HTTP/WS Bridge
MCP_BRIDGE_HOST=127.0.0.1
MCP_BRIDGE_PORT=3001
MCP_SERVER_URL=ws://localhost:3001/mcp
